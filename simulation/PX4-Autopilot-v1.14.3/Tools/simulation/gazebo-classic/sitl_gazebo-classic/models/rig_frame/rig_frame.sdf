<?xml version="1.0" ?>
<!-- RIG-ONLY static wrapper around the bare x500 frame.

     The rig needs the frame pinned: it is the reference every component pose is measured
     against, so if it settles or tips by even a degree, every number read off the rig is wrong
     by that much. Spawned un-pinned it tipped ~11 deg and made the whole readout useless.
     static=true holds it exactly where the rig places it.

     NOT FOR FLIGHT: a static model has no dynamics. The flight vehicle is x500_vlp16.sdf. -->
<sdf version="1.6">
  <model name="rig_frame">
    <static>true</static>
    <include>
      <uri>model://x500</uri>
    </include>
  </model>
</sdf>
