<?xml version="1.0" ?>
<!-- RIG-ONLY static wrapper around tfmini_lidar, so the GUI handles can move it and it stays
     where you drop it instead of falling to the pad.
     NOT FOR FLIGHT: the real mount lives in x500_vlp16.sdf as a nested include. -->
<sdf version="1.6">
  <model name="rig_tfmini">
    <static>true</static>
    <include>
      <uri>model://tfmini_lidar</uri>
    </include>
  </model>
</sdf>
