<?xml version="1.0" ?>
<!-- RIG-ONLY standalone wrapper for rig_camera.

     Gazebo Classic's translate/rotate handles act on MODELS, never on individual links inside
     a model, so nothing in x500_vlp16 can be dragged on its own. This wrapper republishes the
     component as its own model purely so it becomes independently movable while you place it.
     static=true keeps it where you drop it instead of falling.

     NOT FOR FLIGHT. The flight vehicle is x500_vlp16.sdf; once you have the pose you want,
     read it with scripts/dump_gazebo_poses.py and paste it there.
     Mounting plate is the mesh -Z face (70% flat); roll=pi puts it up against the airframe. -->
<sdf version="1.6">
  <model name="rig_camera">
    <static>true</static>
    <link name="camera_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.095</mass>
        <inertia>
          <ixx>6.5e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>6.5e-05</iyy>
          <iyz>0</iyz>
          <izz>4.8e-05</izz>
        </inertia>
      </inertial>

      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.052 0.061 0.084</size>
          </box>
        </geometry>
      </collision>

      <visual name="camera_visual">
        <geometry>
          <mesh>
            <uri>model://iris_vlp16_cam/meshes/siyi_a8_mini.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>

      <sensor name="camera" type="camera">
        <!-- The MESH orientation is cosmetic; this pose is what the camera actually sees.
             Pitch +0.2618 (15 deg) tilts the optical axis forward-and-down. Note the link
             carries roll=pi, so this sensor pose is expressed in that flipped frame. -->
        <pose>0 0 0 3.1415927 0.2617994 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <camera name="a8_mini">
          <horizontal_fov>1.4137</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>15</updateRate>
          <cameraName>camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>camera_link</frameName>
          <hackBaseline>0.0</hackBaseline>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
