#!/bin/sh
#
# @name 3DR Iris Quadrotor with Velodyne VLP-16 and SIYI A8 mini camera
# @type Quadrotor Wide
# @class Copter
#

. ${R}etc/init.d/rc.mc_defaults

SITL_MODEL=iris_vlp16_cam

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 0.1515
param set-default CA_ROTOR0_PY 0.245
param set-default CA_ROTOR0_KM 0.05
param set-default CA_ROTOR1_PX -0.1515
param set-default CA_ROTOR1_PY -0.1875
param set-default CA_ROTOR1_KM 0.05
param set-default CA_ROTOR2_PX 0.1515
param set-default CA_ROTOR2_PY -0.245
param set-default CA_ROTOR2_KM -0.05
param set-default CA_ROTOR3_PX -0.1515
param set-default CA_ROTOR3_PY 0.1875
param set-default CA_ROTOR3_KM -0.05

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104


param set-default COM_RC_IN_MODE 1
param set-default NAV_RCL_ACT 0
param set-default COM_ARM_WO_GPS 1
param set-default COM_ARM_EKF_YAW 3.14
param set-default COM_ARM_MAG_STR 0
param set-default CBRK_IO_SAFETY 22027
param set-default CBRK_SUPPLY_CHK 894281

# Thrust & Mass Tuning. The SIYI A8 mini camera link adds 0.095 kg on top of the 2.33 kg
# VLP-16 configuration (2.425 kg total, +4.1%), so the hover feedforward is nudged up from
# 0.65 by roughly sqrt(2.425/2.33). This is only a feedforward -- the position controller trims
# the remainder -- but starting closer reduces the initial altitude transient on takeoff.
# Thrust-to-weight goes 2.00 -> 1.92 with the extra mass, still ample.
param set-default MPC_THR_HOVER 0.66
param set-default MPC_THR_MAX 1.0

# EKF2: Vision position/velocity (MAG_TYPE=5 disables mag yaw preflight lock).
# Height comes from the downward TFmini rangefinder ONLY (EKF2_HGT_REF=2 = Range, changed from
# 3 = Vision on 2026-09-03): FAST-LIO's LiDAR-SLAM Z estimate is noisier and can drift, and it
# stalls under CPU contention (see PLANNING_DOCS/realtime_test_verification_2026-08-17.md), while
# the rangefinder's data path runs entirely inside the Gazebo<->PX4 SITL pair and never touches
# the ROS graph. Vision (EKF2_EV_CTRL) still supplies X/Y; only the height axis changed reference.
# Consequence: nothing inside PX4 automatically backs up height if range data goes bad, so
# flight_envelope_guard.py carries a range-staleness watchdog (range_timeout) as the backstop.
# See PLANNING_DOCS/fixed_altitude_2d_flight_architecture_2026-09-03.md Sec 14.
param set-default EKF2_EV_DELAY 0
# EKF2_EV_CTRL bitmask (EKF/common.h:151): HPOS=1, VPOS=2, VEL=4, YAW=8.
# 11 = HPOS|VPOS|YAW, i.e. vision supplies X/Y, yaw AND vertical position. Keeping the vertical
# bit is deliberate and was settled by measurement, not preference.
#
# Height still originates from the TFmini alone: FAST-LIO's published Z is the rangefinder reading
# (see PLANNING_DOCS Sec 13), so the vision channel carries TFmini-derived height, not a competing
# LiDAR-SLAM estimate. What it adds is an ABSOLUTE anchor. Dropping the VPOS bit to 9 was tried on
# 2026-09-04 and measurably hurt: EKF2's range-derived height origin drifted, its estimate sat
# 0.28 m below ground truth (vs 0.03 m with VPOS on), and because the position controller flies to
# its own estimate the vehicle cruised at 1.69 m instead of 1.50 m -- eating 0.19 m of the 2 m
# arena margin. With VPOS on, measured ground-truth altitude held 1.38-1.50 m for 145 s.
#
# The reason VPOS was suspected in the first place -- a bad range value corrupting the height
# estimate through two channels at once -- is fixed at its source instead: FAST-LIO now rejects
# out-of-band rangefinder samples (mapping/tfmini_range_min/max) rather than forwarding the ray
# sensor's 35 m no-return sentinel as a real altitude. See Sec 20.3/20.4.
param set-default EKF2_EV_CTRL 11
param set-default EKF2_HGT_REF 2
param set-default EKF2_RNG_CTRL 1
param set-default EKF2_MIN_RNG 0.1
# Where the TFmini actually sits, in body metres below the vehicle origin (EKF2_RNG_POS_Z; the
# param is _Z, NOT _D: PX4 v1.14 defines only EKF2_RNG_POS_X/Y/Z, so a "_D" spelling is silently
# a no-op and leaves the offset uncompensated). This MUST track
# the mount pose in iris_vlp16_cam.sdf (currently <pose>0 0 -0.0725 ...>, so D = +0.0725).
#
# Left at its 0 default the EKF places the sensor at base_link, so with EKF2_HGT_REF=2 the raw
# range IS the height estimate and the vehicle over-climbs by exactly the mount offset to make
# the number read right. Measured 2026-09-06 with this unset after the sensor moved to the
# belly: ground truth 1.6084 m against a 1.50 m command -- 0.058 m ABOVE the guard's
# world_z_max of 1.55 -- and /mavros/local_position/pose reading 1.3324, which left the EDM's
# takeoff gate (climb >= 1.30) permanently unsatisfied. The vehicle hovered over the pad for
# eight minutes and never entered the arena.
#
# Change this whenever the rangefinder is moved, or the same failure returns wearing a
# different mask: the visible symptom was 'MAVROS/EDM never triggers', several layers away.
param set-default EKF2_RNG_POS_Z 0.0725
param set-default EKF2_GPS_CTRL 0
param set-default EKF2_BARO_CTRL 1
param set-default EKF2_MAG_TYPE 5
# EVP 0.05 m was dishonest about FAST-LIO and caused hard position resets. MAVROS's
# vision_pose/pose carries no covariance, so EKF2 falls back to this value as the EV position
# measurement noise (confirmed live: observation_variance 0.0025 = 0.05^2). But FAST-LIO's
# measured agreement with Gazebo ground truth is ~0.10 m, so 0.05 understates the real noise by
# at least 2x. That makes the innovation gate correspondingly tight, ordinary FAST-LIO jitter
# gets rejected, and accumulated rejections make EKF2 snap: the 2026-09-05 08:34 run took a
# 1.87 m xy reset at t+41, the entry module chased it, the vehicle exceeded the 60 deg tilt
# limit and the FailureDetector terminated the flight. 0.10 matches the measured accuracy.
# See PLANNING_DOCS/arena_entry_crash_root_cause_2026-09-05.md.
param set-default EKF2_EVP_NOISE 0.10
param set-default EKF2_EVV_NOISE 0.05
param set-default EKF2_EVA_NOISE 0.05

# AEQ: External heading set to use vision input
param set-default ATT_EXT_HDG_M 1

# Takeoff: Set default takeoff altitude to 1.5m and acceptance radius to 0.2m
param set-default MIS_TAKEOFF_ALT 1.5
param set-default NAV_MC_ALT_RAD 0.2

# Fixed-altitude 2D flight: cap climb rate well below the PX4 default (3.0 m/s), consistent with
# the already-conservative 0.6 m/s horizontal cruise. MPC_Z_VEL_MAX_DN deliberately left at its
# 1.5 m/s default -- this airframe has no separate landing-gear geometry to size a tighter value
# from, and PX4's MPC_LAND_SPEED (0.7 m/s) already governs the final touchdown independently.
param set-default MPC_Z_VEL_MAX_UP 1.8

# Yaw rate ceiling, set for the LiDAR rather than the airframe. Within one 100 ms VLP-16 scan
# the vehicle sweeps (yaw_rate x 0.1) of heading. PX4's defaults (MC_YAWRATE_MAX 200 deg/s,
# MPC_YAWRAUTO_MAX 45) let FUEL's exploration headings drive 158 deg/s on 2026-09-05 -- ~16 deg
# of rotation inside a single scan. That left too few valid correspondences after the blind
# radius cut: FAST-LIO logged "No Effective Points!", stopped correcting, dead-reckoned on IMU
# and ran to 952 m, and the vehicle fell out of the sky (ulog 08_54_42, t+171).
# 60 deg/s holds intra-scan rotation to ~6 deg, which IMU de-skewing handles.
# This is the authoritative limit: flight_envelope_guard.py slews its own setpoint at the same
# rate (nidar/flight/max_yaw_rate), but only PX4 can bound what the vehicle actually does.
param set-default MC_YAWRATE_MAX 60
param set-default MPC_YAWRAUTO_MAX 60

# Failsafe: Enable flight termination (motor kill) when the FailureDetector logic trips
# (FD_FAIL_P/FD_FAIL_R = 60deg tilt, FD_FAIL_P_TTRI/FD_FAIL_R_TTRI = 0.3s -- PX4 stock defaults).
# CBRK_FLIGHTTERM defaults to 121212, which explicitly DISABLES flight termination even after a
# detected attitude failure -- that's why a tipped-over vehicle stays armed with motors idling
# instead of disarming. 0 = breaker not tripped, i.e. termination logic is actually active.
param set-default CBRK_FLIGHTTERM 0

# Failsafe: Disable low battery failsafe landing (Warning only) and battery drain
param set COM_LOW_BAT_ACT 0
param set SIM_BAT_DRAIN 86400
param set BAT_LOW_THR 0
param set BAT_CRIT_THR 0
param set BAT_EMERGEN_THR 0
param set BAT_V_EMPTY 1.0
param set BAT1_V_EMPTY 1.0
